[
  "/mnt/trames-output/linux-keyboard/desktop-release/runner",
  "run",
  "--rootfs",
  "/mnt/trames-output/linux-keyboard/desktop-release/rootfs",
  "--desktop",
  "x11",
  "--xwayland-launcher",
  "/mnt/trames-output/linux-keyboard/desktop-release/launcher",
  "--cpus",
  "1",
  "--timeout-ms",
  "60000",
  "--",
  "/bin/sh",
  "-ec",
